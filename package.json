{
  "name": "tsdown-preset-sxzz",
  "type": "module",
  "version": "0.7.1",
  "description": "An opinionated preset for tsdown.",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/sxzz/tsdown-preset-sxzz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxzz/tsdown-preset-sxzz.git"
  },
  "bugs": {
    "url": "https://github.com/sxzz/tsdown-preset-sxzz/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "tsdown": "^0.22.0 || ^0.23.0-0"
  },
  "dependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "publint": "^0.3.24"
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.6.0",
    "@sxzz/prettier-config": "^2.3.2",
    "@types/node": "^26.1.2",
    "@typescript/native-preview": "npm:typescript@^7.0.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  },
  "prettier": "@sxzz/prettier-config"
}
